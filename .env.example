# ─── SensorOps AI: пример конфигурации ──────────────────────────────────────
# Скопируйте в .env и при необходимости отредактируйте.

# LLM: mock (без ключей, детерминированные ответы) или litellm (реальная модель)
LLM_BACKEND=mock
# Примеры для litellm:
#   OpenAI:    LLM_MODEL=gpt-4o-mini   LLM_API_KEY=sk-...
#   Ollama:    LLM_MODEL=ollama/qwen2.5  LLM_API_BASE=http://localhost:11434/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=
LLM_TEMPERATURE=0.2

# Векторная БД: auto | qdrant | chroma | memory
VECTOR_BACKEND=auto
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sensors
CHROMA_PERSIST_DIR=data/chroma

# Эмбеддинги: auto | sentence-transformers | tfidf
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ASR
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# Зеркало HuggingFace (для сетей с медленным доступом к huggingface.co)
HF_ENDPOINT=https://hf-mirror.com

# Полный стек эмбеддингов при сборке Docker-образа (torch CPU):
# INSTALL_TRANSFORMERS=true

# API
API_HOST=0.0.0.0
API_PORT=8000
# URL API для Streamlit UI
API_URL=http://localhost:8000
